%if 0

hg grep FSIBOOTNAME --all |
  sed -re 's/^boot32.asm:([0-9]+):.*$/\1/' |
  LC_ALL=C sort | LC_ALL=C uniq | xargs -r bash -c '
  for rev;
  do
    hg diff -r "rev($rev)^:rev($rev)" | grep -Ei "^\+.*FSIBOOTNAME";
    hg log -r "rev($rev)" \
    --template="{date|isodate}\n; https://hg.pushbx.org/ecm/ldosboot.exp/rev/{node|short}\n";
  done' scriptlet

for file in ~/wwwecm/download/ldebug/ldebug?.tlz;
do
  base="${file##*/}";
  rel="${base%.tlz}";
  tar -xf "$file" "$rel"/bin/instsect.com;
  grep --binary-files=text -Eo 'FSIBOOT.' "$rel"/bin/instsect.com |
    LC_ALL=C sort | LC_ALL=C uniq;
  ls -lgG --full-time "$rel"/bin/instsect.com;
done

%endif
